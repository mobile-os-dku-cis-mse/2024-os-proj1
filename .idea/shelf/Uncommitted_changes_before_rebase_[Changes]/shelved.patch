+pcb_t* find_and_remove_pcb_by_pid(pcb_queue* queue, pid_t pid) {
+    if (queue == NULL || queue->front == NULL) {
+        // 큐가 비어 있거나 NULL인 경우
+        return NULL;
+    }
+
+    pcb_t* prev = NULL;
+    pcb_t* curr = queue->front;
+
+    while (curr != NULL) {
+        if (curr->pid == pid) {
+            // 해당 PID를 가진 PCB를 찾았으므로 큐에서 제거
+            if (prev == NULL) {
+                // 제거할 노드가 큐의 첫 번째 노드인 경우
+                queue->front = curr->next;
+                if (queue->front == NULL) {
+                    // 큐가 비어 있게 되었으므로 rear도 NULL로 설정
+                    queue->rear = NULL;
+                }
+            } else {
+                // 제거할 노드가 첫 번째 노드가 아닌 경우
+                prev->next = curr->next;
+                if (curr->next == NULL) {
+                    // 제거할 노드가 마지막 노드인 경우 rear 업데이트
+                    queue->rear = prev;
+                }
+            }
+
+            queue->size--;
+            curr->next = NULL; // 노드의 next 포인터를 NULL로 설정
+            return curr;       // 제거된 PCB를 반환
+        }
+        prev = curr;
+        curr = curr->next;
+    }
+
+    // 해당 PID를 가진 PCB를 찾지 못한 경우
+    return NULL;
 }
